# Copy to .env. Only the key for the provider you use is required.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: raises GitHub's limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=

# Models are Pydantic AI "provider:model" strings. "test" runs offline with no API key.
# DEPCOUNCIL_QUICK_MODEL=anthropic:claude-sonnet-5-5
# DEPCOUNCIL_DEEP_MODEL=anthropic:claude-opus-5-5
# DEPCOUNCIL_QUICK_EFFORT=medium
# DEPCOUNCIL_DEEP_EFFORT=high
# DEPCOUNCIL_DEBATE_ROUNDS=1
# DEPCOUNCIL_MAX_TOOL_ROUNDS=4

# Optional: remember each decision here and show the chair lessons from settled ones.
# DEPCOUNCIL_MEMORY_PATH=~/.local/share/depcouncil/memory.jsonl
